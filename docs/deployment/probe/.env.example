# Copy manually into ignored .local-backups/t23/probe.env; use a real deployed origin.
SMOKE_URL=https://your-demo.example
# Leave all three empty for public health/catalog checks only.
# Use a dedicated listener in an isolated synthetic demo, never admin credentials.
SMOKE_USERNAME=
SMOKE_PASSWORD=
SMOKE_ALLOW_SESSION_MUTATIONS=
# To enable login/refresh/logout checks, set the last value to yes and fill credentials.
