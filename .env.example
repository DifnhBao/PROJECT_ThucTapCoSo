# Local Docker stack. Copy to .env and replace every placeholder.
MYSQL_DATABASE=tunetrek_demo
MYSQL_ROOT_PASSWORD=replace-with-local-root-password
DB_USER=tunetrek_app
DB_PASS=replace-with-app-password
MIGRATION_DB_USER=tunetrek_migrator
MIGRATION_DB_PASS=replace-with-migrator-password
WEB_PORT=3000
# Only used with docker-compose.local.yml; default stack does not publish MySQL.
DB_PORT=3306
# Local HTTP only. Deployment: production + exact HTTPS WEB_ORIGINS.
APP_NODE_ENV=development
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JWT_SECRET=replace-with-random-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-distinct-random-refresh-secret-at-least-32-characters
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret
# Only for explicit fresh local demo seed (12-72 characters).
DEMO_SEED_PASSWORD=replace-with-demo-only-password
