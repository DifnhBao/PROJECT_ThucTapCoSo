NODE_ENV=test
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3307
TEST_DB_NAME=tunetrek_test
TEST_DB_USER=tunetrek_test_runner
TEST_DB_PASS=replace-with-local-test-password
# Enable only for an isolated disposable test database.
TEST_DB_RESET_ALLOWED=no
TEST_SEED_PASSWORD=replace-with-test-only-password
# Separate disposable root password used only by docker-compose.test.yml.
TEST_MYSQL_ROOT_PASSWORD=replace-with-test-only-root-password
JWT_SECRET=replace-with-distinct-test-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-distinct-test-refresh-secret-at-least-32-characters
CLOUDINARY_CLOUD_NAME=test-only
CLOUDINARY_API_KEY=test-only
CLOUDINARY_API_SECRET=test-only
