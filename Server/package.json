{
  "name": "music-backend",
  "version": "1.0.0",
  "type": "commonjs",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "node --require ./tests/helpers/unit-setup.cjs --test --test-concurrency=2 tests/unit/*.test.cjs tests/api/*.test.cjs",
    "test:unit": "node --require ./tests/helpers/unit-setup.cjs --test --test-concurrency=2 tests/unit/*.test.cjs",
    "test:api": "node --require ./tests/helpers/unit-setup.cjs --test --test-concurrency=2 tests/api/*.test.cjs",
    "test:integration": "node tests/helpers/run-integration.cjs",
    "db:migrate": "node scripts/db-migrate.cjs",
    "db:seed:demo": "node scripts/db-seed.cjs demo",
    "db:seed:test": "node scripts/db-seed.cjs test",
    "docs:api": "node scripts/generate-openapi.cjs",
    "start": "node src/server.js ",
    "dev": "node --watch src/server.js",
    "uploads:cleanup": "node scripts/uploads-cleanup.cjs",
    "recommendations:rebuild": "node scripts/recommendations-rebuild.cjs",
    "test:recommendation:integration": "node --test tests/helpers/run-recommendation-integration.cjs",
    "evaluate:recommendations": "node ../Benchmark/evaluate.cjs",
    "lint": "node ../UI/node_modules/eslint/bin/eslint.js ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
