    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "file-type": "22.2.0",
    "fs-extra": "^11.3.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "mysql2": "^3.24.6",
    "sequelize": "^6.37.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "sequelize-cli": "^6.6.5"
  }
