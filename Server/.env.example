# Runtime configuration. Copy to Server/.env; never commit real credentials.
NODE_ENV=development
PORT=5000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tunetrek_demo
DB_USER=tunetrek_app
DB_PASS=replace-with-app-db-password
# External MySQL: verify_identity. Local/private Compose DB: disabled.
DB_TLS_MODE=disabled
# Optional PEM CA bundle, with literal \n accepted; never disable certificate verification.
DB_TLS_CA=
# Shared free databases may need a lower per-process connection limit (1-10).
DB_POOL_MAX=10
# DDL-only account; provide to migration process, never to API deployment runtime.
# MIGRATION_DB_USER=tunetrek_migrator
# MIGRATION_DB_PASS=replace-with-migrator-password
# Synthetic local demo seed only; keep opt-in off by default.
DEMO_SEED_ALLOWED=no
DEMO_SEED_PASSWORD=replace-with-demo-only-password
# Distinct random secrets, each at least 32 characters.
JWT_SECRET=replace-with-random-access-secret
JWT_REFRESH_SECRET=replace-with-different-random-refresh-secret
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret
# Comma-separated exact origins. Production requires explicit HTTPS origins.
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional internal diagnostics; leave off in demo/production.
DEBUG_RECOMMENDATION=false

# T07 single-instance quotas. Counters reset on process restart.
# Trusted proxy must overwrite forwarded headers; API ingress must be private.
# Empty = ignore all forwarded headers. Never use true or hop counts.
TRUSTED_PROXY_CIDRS=
RATE_API_MAX=600
RATE_API_WINDOW_MS=60000
RATE_LOGIN_IP_MAX=20
RATE_LOGIN_IP_WINDOW_MS=900000
RATE_LOGIN_ACCOUNT_MAX=10
RATE_LOGIN_ACCOUNT_WINDOW_MS=900000
RATE_REGISTER_MAX=10
RATE_REGISTER_WINDOW_MS=3600000
RATE_REFRESH_MAX=60
RATE_REFRESH_WINDOW_MS=60000
RATE_UPLOAD_MAX=5
RATE_UPLOAD_WINDOW_MS=3600000
RATE_ACTIVITY_MAX=120
RATE_ACTIVITY_WINDOW_MS=60000
RATE_RECOMMENDATION_MAX=60
RATE_RECOMMENDATION_WINDOW_MS=60000
RATE_REBUILD_MAX=1
RATE_REBUILD_WINDOW_MS=300000
RATE_STORE_MAX_ENTRIES=10000
UPLOAD_REQUEST_MAX_BYTES=23068672
ACTIVITY_BODY_MAX_BYTES=8192
RECOMMENDATION_CANDIDATE_MAX=100
REBUILD_SONG_MAX=100
